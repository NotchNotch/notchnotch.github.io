---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ExtensionCard from "../../components/ExtensionCard.astro";
import catalog from "../../data/catalog.json";

const extensions = [...catalog.extensions].sort((a, b) => a.manifest.name.localeCompare(b.manifest.name));
const categories = [...new Set(extensions.flatMap((entry) => entry.manifest.categories ?? []))].sort();
---

<StarlightPage frontmatter={{ title: "Store", description: "Extensions for NotchNotch, reviewed and signed.", tableOfContents: false }}>
  <p>Every extension here was reviewed in <a href="https://github.com/NotchNotch/notchnotch-extensions">notchnotch-extensions</a>, and NotchNotch checks each download against the signed catalog. Install from an extension's page, or from <strong>Settings &amp; Extensions… › Store</strong> in the app.</p>

  <div class="filters">
    <input type="search" id="search" placeholder="Search extensions" aria-label="Search extensions" />
    <div class="chips" role="group" aria-label="Categories">
      <button type="button" data-category="" aria-pressed="true">All</button>
      {categories.map((category) => <button type="button" data-category={category} aria-pressed="false">{category}</button>)}
    </div>
  </div>

  <div class="grid" id="extensions">
    {extensions.map((entry) => <ExtensionCard entry={entry} />)}
  </div>
  <p id="empty" hidden>No extensions match.</p>

  <p class="fine">Built one? <a href="/docs/extensions/publishing/#publish-to-the-store">Submit it with <code>notchnotch publish</code></a>.</p>
</StarlightPage>

<script>
  const search = document.querySelector<HTMLInputElement>("#search")!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>("[data-category]")];
  const cards = [...document.querySelectorAll<HTMLElement>("#extensions .card")];
  let category = "";
  function update() {
    const words = search.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const card of cards) {
      const visible = words.every((word) => card.dataset.search!.includes(word))
        && (!category || card.dataset.categories!.split("|").includes(category));
      card.hidden = !visible;
      if (visible) shown++;
    }
    document.querySelector<HTMLElement>("#empty")!.hidden = shown > 0;
  }
  search.addEventListener("input", update);
  for (const chip of chips) chip.addEventListener("click", () => {
    category = chip.dataset.category!;
    for (const other of chips) other.setAttribute("aria-pressed", String(other === chip));
    update();
  });
</script>

<style>
  .filters { display: flex; flex-direction: column; gap: 0.75rem; margin: 1.5rem 0 1rem; }
  input[type="search"] {
    width: 100%; max-width: 28rem; padding: 0.6rem 0.9rem; border-radius: 0.6rem; font: inherit;
    border: 1px solid var(--sl-color-gray-5); background: var(--sl-color-bg-nav); color: var(--sl-color-white);
  }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chips button {
    font: inherit; font-size: var(--sl-text-sm); padding: 0.3rem 0.8rem; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--sl-color-gray-5); background: transparent; color: var(--sl-color-gray-2);
  }
  .chips button[aria-pressed="true"] { background: var(--sl-color-white); color: var(--sl-color-black); border-color: var(--sl-color-white); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: 1rem; }
  .grid :global([hidden]) { display: none; }
  .fine { color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); margin-top: 2rem; }
</style>
