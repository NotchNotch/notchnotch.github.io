---
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import HeroNotch from "../components/HeroNotch.astro";
import MiniNotch from "../components/MiniNotch.astro";
import CounterDemo from "../components/CounterDemo.astro";
import CopyCommand from "../components/CopyCommand.astro";
import ExtensionCard from "../components/ExtensionCard.astro";
import Icon from "../components/Icon.astro";
import { release, catalog } from "../lib/site";

const pick = (handle: string) => catalog.extensions.find((entry) => entry.handle === handle);
const featured = ["system-monitor", "weather", "world-clock", "hacker-news", "crypto-prices", "countdown"]
  .map((name) => pick(`sadeqi-ah/${name}`)).filter((entry) => entry !== undefined);
const reviewed = pick("sadeqi-ah/github-notifications");
const breakReminder = pick("sadeqi-ah/break-reminder");

const moments = [
  { variant: "compact", title: "Live", text: "A reading either side of the camera. Other live activities join as circles." },
  { variant: "peek", title: "Announcements", text: "One line under the camera when something changes." },
  { variant: "expanded", title: "Open", text: "Hover or click for the whole activity. It never scrolls." },
  { variant: "prompt", title: "Questions", text: "Opens on its own and waits. Closing never answers for you." },
  { variant: "home", title: "Home", text: "Every activity in one grid. It grows wider, never scrolls." },
  { variant: "drop", title: "Drops", text: "Drag a file onto the notch. The extensions that take it appear." },
] as const;

const builtIn = [
  { icon: "music", title: "Music", text: "Spotify, Apple Music or anything in Now Playing, with controls.", href: "/docs/guide/using-notchnotch/#music" },
  { icon: "calendar", title: "Calendar", text: "Your next meeting, with a button to join it.", href: "/docs/guide/using-notchnotch/#calendar" },
  { icon: "tray", title: "Shelf", text: "Drop files on the notch and pick them up later.", href: "/docs/guide/using-notchnotch/#shelf" },
  { icon: "menu", title: "Menu bar icons", text: "The menu bar icons the camera hides, in the open notch.", href: "/docs/guide/using-notchnotch/#menu-bar" },
] as const;

const can = [
  { icon: "sparkle", title: "Live activities", text: "A reading beside the camera, a tile in Home, a full view when open.", href: "/docs/extensions/concepts/" },
  { icon: "bolt", title: "Questions", text: "Open the notch on their own and wait for an answer.", href: "/docs/extensions/concepts/" },
  { icon: "tray", title: "Drops", text: "Take the files, links and text dragged onto the notch.", href: "/docs/extensions/drops/" },
  { icon: "globe", title: "The web", text: "Call the APIs your manifest lists.", href: "/docs/extensions/network/" },
  { icon: "key", title: "Secrets", text: "Keep tokens and passwords in the Keychain.", href: "/docs/extensions/storage/" },
  { icon: "cpu", title: "Your Mac", text: "Calendars, what's playing, the battery and system load.", href: "/docs/extensions/capabilities/" },
  { icon: "terminal", title: "Apps and tools", text: "Talk to an app on the Mac, or ship a native helper.", href: "/docs/extensions/connections/" },
  { icon: "edit", title: "Settings", text: "Native fields from the manifest, or a page of your own.", href: "/docs/extensions/preferences/" },
] as const;

const counter = `import { useState } from "react";
import { Activity, Button, Symbol, Text } from "@notchnotch/sdk";
import { start } from "@notchnotch/runtime";

function Counter() {
  const [count, setCount] = useState(0);
  return (
    <Activity id="counter" title="Counter">
      <Activity.Compact
        leading={<Symbol name="plus.circle" />}
        trailing={<Text>{count}</Text>}
      />
      <Activity.Expanded>
        <Text size="title">{count} little steps</Text>
        <Button title="One more"
          onPress={() => setCount((n) => n + 1)} />
      </Activity.Expanded>
    </Activity>
  );
}

start(<Counter />);`;
---

<Base>
  <!-- Hero: the top of the page is the top of the screen -->
  <section class="hero">
    <div class="notch-anchor"><HeroNotch /></div>
    <div class="hero-glow" aria-hidden="true"></div>

    <div class="container hero-copy">
      <div class="tabs rise" role="tablist" aria-label="Show in the notch" data-blob="button">
        <button type="button" role="tab" data-notch-tab="music" aria-selected="true"><Icon name="music" size={14} /> Music<span class="run"></span></button>
        <button type="button" role="tab" data-notch-tab="timer" aria-selected="false"><Icon name="timer" size={14} /> Focus Timer<span class="run"></span></button>
        <button type="button" role="tab" data-notch-tab="home" aria-selected="false"><Icon name="grid" size={14} /> Home<span class="run"></span></button>
        <button type="button" role="tab" data-notch-tab="drop" aria-selected="false"><Icon name="tray" size={14} /> Drops<span class="run"></span></button>
      </div>

      <h1 class="display hero-title rise" data-delay="1">The notch,<br />put to work.</h1>
      <p class="lede hero-lede rise" data-delay="2">NotchNotch turns the space around your Mac's camera into a quiet place for what's happening now. The song that's playing, your next meeting, a timer, or anything an extension adds.</p>
      <div class="hero-actions rise" data-delay="3">
        <a class="button primary large" href={release.url}><Icon name="download" /> Download for Mac</a>
        <a class="button large" href="/store/">Browse the Store</a>
      </div>
      <p class="fine rise" data-delay="3">Version {release.version} · Free and open source · macOS 14 or later</p>
    </div>
  </section>

  <!-- How it behaves -->
  <section class="container section">
    <header class="head reveal">
      <span class="label">How it behaves</span>
      <h2 class="title">Quiet until it matters.</h2>
      <p class="lede">The notch has a few shapes, and every extension uses the same ones. NotchNotch draws them natively, so they look and move alike.</p>
    </header>
    <div class="grid-3">
      {moments.map((moment, i) => (
        <article class="stage-card reveal" data-delay={String(i % 3)}>
          <div class="stage moment-stage"><MiniNotch variant={moment.variant} /></div>
          <div class="stage-label"><span><b>{moment.title}</b><span>{moment.text}</span></span></div>
        </article>
      ))}
    </div>
  </section>

  <!-- Built in -->
  <section class="container builtin reveal">
    <p class="can-title">Comes with</p>
    <div class="can-grid four">
      {builtIn.map((item) => (
        <a href={item.href}><span class="tile"><Icon name={item.icon} size={16} /></span><span><b>{item.title}</b><span>{item.text}</span></span></a>
      ))}
    </div>
  </section>

  <!-- Numbers -->
  <section class="container numbers reveal">
    {[
      ["0.4%", "CPU when idle, with 13 extensions"],
      ["27 MB", "of memory for the app"],
      ["< 1", "wakeup a second, all processes"],
      ["0", "accounts, analytics or trackers"],
    ].map(([value, text]) => <div><b>{value}</b><span>{text}</span></div>)}
  </section>

  <!-- Store -->
  <section class="container section">
    <header class="head split reveal">
      <div>
        <span class="label">The Store</span>
        <h2 class="title">Make it yours.</h2>
      </div>
      <div class="side">
        <p class="lede">{catalog.extensions.length} extensions, each reviewed in the open and checked against a signed catalog before it installs.</p>
        <a class="link" href="/store/">Browse the Store <span class="arrow">→</span></a>
      </div>
    </header>
    <div class="grid-3">
      {featured.map((entry, i) => <div class="reveal" data-delay={String(i % 3)}><ExtensionCard entry={entry} /></div>)}
    </div>
  </section>

  <!-- Developers -->
  <section class="container section" id="developers">
    <header class="head reveal">
      <span class="label">For developers</span>
      <h2 class="title">Write React. Get native.</h2>
      <p class="lede">Describe the notch with components you know. Each extension runs in its own process, and NotchNotch draws what it returns with the system's own controls.</p>
    </header>
    <div class="dev reveal">
      <div class="stage-card code-card">
        <div class="stage code"><Code code={counter} lang="tsx" theme="github-dark-default" /></div>
        <div class="stage-label"><span class="tile"><Icon name="code" size={16} /></span><span><b>src/index.tsx</b><span>The whole extension</span></span></div>
      </div>
      <div class="stage-card">
        <div class="stage counter-stage"><CounterDemo /></div>
        <div class="stage-label"><span class="tile"><Icon name="sparkle" size={16} /></span><span><b>What it draws</b><span>Click the notch, then One more</span></span></div>
      </div>
    </div>
    <div class="dev-cta reveal">
      <CopyCommand command="npm create notchnotch-extension@latest" />
      <a class="link" href="/docs/extensions/getting-started/">Getting started <span class="arrow">→</span></a>
    </div>
    <div class="can reveal">
      <p class="can-title">What an extension can do</p>
      <div class="can-grid">
        {can.map((item) => (
          <a href={item.href}><span class="tile"><Icon name={item.icon} size={16} /></span><span><b>{item.title}</b><span>{item.text}</span></span></a>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section class="container section">
    <div class="trust reveal">
      <div class="trust-copy">
        <span class="label">Safe by default</span>
        <h2 class="title">You see what an extension can reach before it does.</h2>
        <ul>
          <li><Icon name="box" size={16} /><span><b>Its own sandbox.</b> A separate process that can't touch your files or the network unless its manifest says so.</span></li>
          <li><Icon name="eye" size={16} /><span><b>Reviewed before install.</b> Websites, apps and services, riskiest first. Updates that want more wait for you.</span></li>
          <li><Icon name="shield" size={16} /><span><b>Signed end to end.</b> The Store's catalog is signed, and each download must match what was reviewed.</span></li>
        </ul>
        <a class="link" href="/security/">Security <span class="arrow">→</span></a>
      </div>
      <div class="stage review-stage">
        <div class="sheet">
          <div class="sheet-head">
            {reviewed?.icon && <img src={reviewed.icon} alt="" width="40" height="40" />}
            <div><b>{reviewed?.manifest.name ?? "GitHub Notifications"}</b><span>sadeqi-ah · {reviewed?.manifest.version}</span></div>
          </div>
          <p class="sheet-title">Beyond its sandbox, it can</p>
          <ul>
            <li><span class="si"><Icon name="globe" size={14} /></span><div><b>Reach a website</b><span>api.github.com</span></div></li>
            <li class="new"><span class="si"><Icon name="key" size={14} /></span><div><b>Keep a secret in your Keychain</b><span>Personal Access Token</span></div><em>New</em></li>
          </ul>
          <div class="sheet-actions"><span>Cancel</span><span class="go">Install</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final: the notch asks, as an extension's question would -->
  <section class="final reveal">
    <div class="ask">
      <div class="ask-controls" aria-hidden="true">
        <svg viewBox="0 0 16 16"><rect x="2" y="2" width="5" height="5" rx="1.3"/><rect x="9" y="2" width="5" height="5" rx="1.3"/><rect x="2" y="9" width="5" height="5" rx="1.3"/><rect x="9" y="9" width="5" height="5" rx="1.3"/></svg>
        <svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="2.4"/><path d="M6.9 1.6h2.2l.4 1.8 1.2.7 1.8-.6 1.1 1.9-1.4 1.2v1.4l1.4 1.2-1.1 1.9-1.8-.6-1.2.7-.4 1.8H6.9l-.4-1.8-1.2-.7-1.8.6-1.1-1.9 1.4-1.2V6.6L2.4 5.4l1.1-1.9 1.8.6 1.2-.7.4-1.8Z" stroke-linejoin="round"/></svg>
      </div>
      <div class="ask-head">
        <span class="ask-icon"><Icon name="logo" size={18} /></span>
        <div>
          <h2 class="ask-title">Put your notch to work?</h2>
          <p class="ask-sub">NotchNotch {release.version} · Free<span class="ask-os"> · macOS 14 or later</span></p>
        </div>
      </div>
      <div class="ask-actions">
        <a class="ask-btn" href="/docs/guide/using-notchnotch/">Read the guide</a>
        <a class="ask-btn on" href={release.url}><Icon name="download" size={14} /> Download</a>
      </div>
    </div>
    <p class="fine">Not notarized yet: the first time, choose Open Anyway in System Settings › Privacy &amp; Security. <a href="/docs/guide/using-notchnotch/#install">How</a></p>
  </section>
</Base>

<style>
  /* Hero */
  .hero { position: relative; padding-top: 380px; overflow-x: clip; }
  /* Hangs from the bar, as the notch hangs from the menu bar */
  .notch-anchor {
    position: fixed; inset: var(--nav-h) 0 auto; height: 0; z-index: 40;
    transition: transform 0.32s var(--ease) 0.08s, visibility 0s;
  }
  /* Scrolled: the notch closes to the camera and goes up into the bar, then
     hides, so it doesn't show through the bar once that turns translucent. */
  .notch-anchor:has(:global([data-tucked])) {
    transform: translateY(-64px); visibility: hidden;
    transition: transform 0.32s var(--ease) 0.1s, visibility 0s 0.45s;
  }
  .hero-glow {
    position: absolute; left: 50%; top: -160px; width: 900px; height: 520px; transform: translateX(-50%); z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, rgb(255 255 255 / 0.06), transparent);
  }
  .hero-copy { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .hero-title { font-size: clamp(44px, 7vw, 76px); margin-top: 44px; }
  .hero-lede { max-width: 560px; margin-top: 20px; }
  .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 30px; }
  .hero-copy .fine { margin-top: 16px; }

  .tabs { display: flex; padding: 4px; border-radius: 999px; background: var(--card); box-shadow: var(--material); }
  .tabs button {
    position: relative; display: inline-flex; align-items: center; gap: 7px;
    height: 32px; padding: 0 14px; border: 0; border-radius: 999px; background: none; cursor: pointer;
    font-size: 13px; font-weight: 500; color: var(--text-3); transition: color var(--fast);
  }
  .tabs button:hover, .tabs button[aria-selected="true"] { color: var(--text); }
  .tabs :global(.blob) { --blob: rgb(255 255 255 / 0.09); }
  .run { position: absolute; left: 14px; right: 14px; bottom: 4px; height: 1.5px; border-radius: 2px; background: rgb(255 255 255 / 0.5); transform: scaleX(0); transform-origin: left; opacity: 0; }
  :global(.running) > .run { opacity: 1; animation: run var(--run) linear forwards; }
  @keyframes run { to { transform: scaleX(1); } }

  /* Sections */
  .section { padding-top: 150px; }
  .head { max-width: 620px; margin-bottom: 36px; }
  .head .title { margin-top: 10px; }
  .head .lede { margin-top: 14px; }
  .head.split { max-width: none; display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; flex-wrap: wrap; }
  .head .side { max-width: 380px; display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .head .side .lede { margin-top: 0; font-size: 15px; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .grid-3 > .reveal:not(.stage-card) { display: flex; }
  .grid-3 > .reveal:not(.stage-card) > :global(*) { flex: 1; }

  .moment-stage { height: 176px; }
  .moment-stage :global(.mini) { --mz: 0.7; }
  .moment-stage :global(.mini[data-v="home"]), .moment-stage :global(.mini[data-v="drop"]) { --mz: 0.6; }

  .builtin { margin-top: 110px; }
  .numbers { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 80px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .numbers div { padding: 28px 24px; display: flex; flex-direction: column; gap: 4px; }
  .numbers div + div { border-left: 1px solid var(--line); }
  .numbers b { font-family: var(--font-display); font-size: 32px; font-weight: 500; letter-spacing: -0.03em; }
  .numbers span { font-size: 13px; color: var(--text-3); }

  .dev { display: grid; grid-template-columns: 1.3fr 1fr; gap: 12px; }
  .dev > * { min-width: 0; }
  .code { height: 100%; }
  .code-card .code { flex: 1; }
  .code :global(pre.astro-code) { background: transparent !important; box-shadow: none; padding: 20px 22px; font-size: 12.5px; }
  .counter-stage { flex: 1; min-height: 300px; }
  .can { margin-top: 64px; }
  .can-title { font-size: 13px; font-weight: 500; color: var(--text-3); margin: 0 0 14px; }
  .can-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; border-radius: 18px; overflow: hidden; background: var(--line); box-shadow: var(--material); }
  .can-grid a { display: flex; gap: 12px; padding: 20px 18px; background: var(--card); transition: background-color var(--fast); }
  .can-grid a:hover { background: var(--raised); }
  .can-grid a > span:last-child { display: flex; flex-direction: column; gap: 3px; }
  .can-grid b { font-size: 14px; font-weight: 500; }
  .can-grid a > span:last-child > span { font-size: 13px; line-height: 1.45; color: var(--text-3); }
  .can-grid .tile { flex: none; width: 32px; height: 32px; border-radius: 9px; display: grid; place-items: center; background: var(--chip); color: var(--text-2); }
  .dev-cta { display: flex; align-items: center; justify-content: center; gap: 24px; flex-wrap: wrap; margin-top: 28px; }

  .trust { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 6px; border-radius: 22px; background: var(--card); box-shadow: var(--material); }
  .trust-copy { padding: 36px 32px; }
  .trust .title { font-size: clamp(26px, 2.8vw, 34px); margin-top: 10px; }
  .trust ul { list-style: none; margin: 28px 0; padding: 0; display: grid; gap: 16px; }
  .trust li { display: flex; gap: 12px; color: var(--text-2); font-size: 14px; }
  .trust li :global(svg) { flex: none; margin-top: 3px; color: var(--text-3); }
  .trust li b { color: var(--text); font-weight: 500; }
  .review-stage { display: grid; place-items: center; padding: 36px 24px; }
  .sheet { width: 100%; max-width: 360px; padding: 18px; border-radius: 18px; background: #1c1c1e; box-shadow: var(--float); }
  .sheet-head { display: flex; gap: 12px; align-items: center; }
  .sheet-head img { width: 40px; height: 40px; }
  .sheet-head div { display: flex; flex-direction: column; }
  .sheet-head b { font-weight: 600; font-size: 14px; }
  .sheet-head span { font-size: 12px; color: var(--text-3); }
  .sheet-title { font-size: 12px; color: var(--text-3); margin: 18px 0 8px; }
  .sheet ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .sheet li { display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 11px; background: rgb(255 255 255 / 0.04); }
  .sheet li div { flex: 1; display: flex; flex-direction: column; font-size: 13px; }
  .sheet li span:not(.si) { font-size: 12px; color: var(--text-3); }
  .si { width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; background: rgb(255 255 255 / 0.07); color: var(--text-2); flex: none; }
  .sheet li.new { box-shadow: inset 0 0 0 1px rgb(255 179 64 / 0.35); }
  .sheet li em { font-style: normal; font-size: 11px; font-weight: 600; color: #ffc35a; }
  .sheet-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px; font-size: 13px; font-weight: 500; }
  .sheet-actions span { height: 28px; padding: 0 14px; display: grid; place-items: center; border-radius: 999px; background: rgb(255 255 255 / 0.08); }
  .sheet-actions .go { background: var(--accent); }

  /* A prompt in the open notch, hanging from a hairline as the notch hangs from the menu bar */
  .final { margin-top: 170px; border-top: 1px solid var(--line-strong); display: flex; flex-direction: column; align-items: center; text-align: center; }
  .ask {
    --shoulder: 28px;
    position: relative; width: min(440px, calc(100% - 2 * var(--shoulder) - 16px)); margin-top: -1px;
    padding: 0 28px 24px; background: #000; border-radius: 0 0 34px 34px; text-align: left;
    box-shadow: 0 14px 40px rgb(0 0 0 / 0.45);
  }
  .ask::before, .ask::after { content: ""; position: absolute; top: 0; width: var(--shoulder); height: var(--shoulder); }
  .ask::before { right: 100%; background: radial-gradient(circle at 0 100%, transparent calc(var(--shoulder) - 0.5px), #000 var(--shoulder)); }
  .ask::after { left: 100%; background: radial-gradient(circle at 100% 100%, transparent calc(var(--shoulder) - 0.5px), #000 var(--shoulder)); }
  .ask-controls { height: 40px; display: flex; justify-content: flex-end; align-items: center; gap: 2px; margin-right: -4px; color: rgb(255 255 255 / 0.5); }
  .ask-controls svg { width: 24px; height: 24px; padding: 6px; fill: none; stroke: currentColor; stroke-width: 1.3; }
  .ask-head { display: flex; gap: 12px; align-items: center; }
  .ask-icon { width: 36px; height: 36px; flex: none; border-radius: 9px; background: #fff; color: #000; display: grid; place-items: center; }
  .ask-title { margin: 0; font-size: 19px; font-weight: 600; letter-spacing: -0.2px; line-height: 1.25; }
  .ask-sub { margin: 2px 0 0; font-size: 12.5px; color: rgb(255 255 255 / 0.55); }
  .ask-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 22px; }
  .ask-btn {
    height: 32px; padding: 0 14px; border-radius: 999px; display: inline-flex; align-items: center; gap: 6px;
    font-size: 13.5px; font-weight: 500; background: rgb(255 255 255 / 0.12); color: #fff;
    transition: background-color var(--quick), transform var(--quick);
  }
  .ask-btn:hover { background: rgb(255 255 255 / 0.18); }
  .ask-btn.on { background: #fff; color: #000; }
  .ask-btn.on:hover { background: rgb(255 255 255 / 0.88); }
  .ask-btn:active { transform: scale(0.97); }
  .final .fine { margin-top: 28px; max-width: 440px; padding: 0 20px; }
  .final .fine a { color: var(--text-2); text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 1199px) {
    .hero { padding-top: calc(var(--nav-h) + 16px); }
    .notch-anchor {
      position: relative; inset: auto; transform: none !important; height: 230px; margin: 0 16px; border-radius: 22px;
      background: var(--stage); box-shadow: var(--material); overflow: hidden;
    }
    .notch-anchor :global(.hn) { --zoom: 1; }
    .hero-title { margin-top: 36px; }
  }
  @media (max-width: 480px) {
    .ask { padding: 0 20px 20px; }
    .ask-os { display: none; }
    .ask-actions { justify-content: stretch; }
    .ask-btn { flex: 1; justify-content: center; }
  }
  @media (max-width: 960px) {
    .grid-3 { grid-template-columns: 1fr 1fr; }
    .dev, .trust { grid-template-columns: 1fr; }
    .can-grid { grid-template-columns: 1fr 1fr; }
    .numbers { grid-template-columns: 1fr 1fr; }
    .numbers div:nth-child(3) { border-left: 0; }
    .numbers div:nth-child(n+3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 480px) { .notch-anchor :global(.hn) { --zoom: 0.72; } }
  @media (max-width: 640px) {
    .grid-3 { grid-template-columns: 1fr; }
    .can-grid { grid-template-columns: 1fr; }
