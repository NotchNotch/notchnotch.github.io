---
import Base from "../layouts/Base.astro";
---

<Base title="Not found">
  <section class="container lost">
    <div class="notch" aria-hidden="true"></div>
    <h1 class="display">Nothing here.</h1>
    <p class="lede">This page moved or never existed. Search, or head back home.</p>
    <div class="actions">
      <a class="button primary" href="/">Home</a>
      <button class="button secondary" type="button" data-open-search>Search <kbd>⌘K</kbd></button>
    </div>
  </section>
</Base>

<style>
  .lost { min-height: 70vh; padding-top: calc(var(--nav-h) + 120px); text-align: center; display: flex; flex-direction: column; align-items: center; }
  .notch { width: 200px; height: 34px; border-radius: 0 0 14px 14px; background: #111; box-shadow: inset 0 0 0 1px var(--line); margin-bottom: 48px; }
  h1 { font-size: clamp(48px, 8vw, 88px); }
  .lede { margin-top: 20px; }
  .actions { display: flex; gap: 12px; margin-top: 32px; }
</style>
