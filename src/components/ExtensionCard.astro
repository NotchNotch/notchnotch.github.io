---
import { authorOf, storeUrl, type CatalogEntry } from "../lib/site";
import Shot from "./Shot.astro";

interface Props { entry: CatalogEntry; shot?: boolean }
const { entry, shot = true } = Astro.props;
const { manifest } = entry;
const author = authorOf(entry);
const categories = manifest.categories ?? [];
const screenshot = entry.screenshots?.[0];
const id = entry.handle.replace("/", "-");
---

<a class:list={["stage-card", "extension", { compact: !shot }]} href={storeUrl(entry)}
   data-search={`${manifest.name} ${manifest.description} ${author} ${categories.join(" ")}`.toLowerCase()}
   data-categories={categories.join("|")}>
  {shot && (screenshot
    ? <Shot src={screenshot} alt="" height={176} />
    : <div class="stage fallback">{entry.icon && <img src={entry.icon} alt="" width="72" height="72" loading="lazy" />}</div>)}
  <div class="stage-label">
    <span class="tile">{entry.icon ? <img src={entry.icon} width="34" height="34" alt="" loading="lazy" transition:name={`icon-${id}`} /> : null}</span>
    <span class="text">
      <b>{manifest.name}</b>
      <span>{manifest.description}</span>
    </span>
  </div>
</a>

<style>
  .extension { height: 100%; }
  .text { min-width: 0; }
  .text span { display: -webkit-box !important; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .extension .tile { background: none; box-shadow: none; }
  .extension :global(.shot img) { transition: transform 0.6s var(--ease); }
  .extension:hover :global(.shot img) { transform: scale(1.025); }
  .fallback { height: 176px; display: grid; place-items: center; }
  .fallback img { width: 72px; height: 72px; filter: drop-shadow(0 12px 28px rgb(0 0 0 / 0.5)); transition: transform 0.6s var(--ease); }
  .extension:hover .fallback img { transform: scale(1.05); }
  .compact .text span { -webkit-line-clamp: 2; }
</style>
