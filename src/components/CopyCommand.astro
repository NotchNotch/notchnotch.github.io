---
import Icon from "./Icon.astro";
interface Props { command: string }
const { command } = Astro.props;
---

<button class="copy-command" type="button" data-copy={command} aria-label={`Copy ${command}`}>
  <span class="prompt">$</span>
  <code>{command}</code>
  <span class="state"><span class="copy"><Icon name="copy" size={16} /></span><span class="done"><Icon name="check" size={16} /></span></span>
</button>

<script>
  document.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>("[data-copy]");
    if (!button) return;
    await navigator.clipboard?.writeText(button.dataset.copy!);
    button.classList.add("copied");
    setTimeout(() => button.classList.remove("copied"), 1600);
  });
</script>

<style>
  .copy-command {
    display: inline-flex; align-items: center; gap: 12px; height: 42px; padding: 0 12px 0 16px;
    border: 0; border-radius: 999px; cursor: pointer; text-align: left;
    background: var(--bg-sunk); box-shadow: var(--material); background: var(--card);
    font-size: 13px; transition: box-shadow 0.2s;
  }
  .copy-command:hover { box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.24); }
  .prompt { color: var(--text-3); font-family: var(--mono); }
  code { color: var(--text); }
  .state { position: relative; width: 16px; height: 16px; margin-left: 8px; color: var(--text-3); }
  .state > span { position: absolute; inset: 0; transition: opacity 0.2s, transform 0.25s var(--ease); }
  .done { opacity: 0; transform: scale(0.5); color: var(--green); }
  .copied .copy { opacity: 0; transform: scale(0.5); }
  .copied .done { opacity: 1; transform: none; }
</style>
