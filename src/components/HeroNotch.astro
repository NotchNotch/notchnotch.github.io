---
// The landing page's notch, a port of the app's NotchView: the same
// silhouette (shoulders that flare out into the screen edge), the same sizes
// per presentation, and what Music, Focus Timer, Home and a drop draw.
// Sizes are in points, as in NotchGeometry and HomeLayout, at a camera of 184 × 32.

// The shared SF Symbol stand-ins, drawn on a 16-point grid.
const sym = {
  grid: '<rect x="2" y="2" width="5" height="5" rx="1.3"/><rect x="9" y="2" width="5" height="5" rx="1.3"/><rect x="2" y="9" width="5" height="5" rx="1.3"/><rect x="9" y="9" width="5" height="5" rx="1.3"/>',
  gear: '<circle cx="8" cy="8" r="2.4"/><path d="M6.9 1.6h2.2l.4 1.8 1.2.7 1.8-.6 1.1 1.9-1.4 1.2v1.4l1.4 1.2-1.1 1.9-1.8-.6-1.2.7-.4 1.8H6.9l-.4-1.8-1.2-.7-1.8.6-1.1-1.9 1.4-1.2V6.6L2.4 5.4l1.1-1.9 1.8.6 1.2-.7.4-1.8Z" stroke-linejoin="round"/>',
  timer: '<circle cx="8" cy="9" r="5.4"/><path d="M8 9 6.2 6.9M6.4 1.8h3.2"/>',
  cloud: '<circle cx="5.6" cy="6" r="2.4"/><path d="M5.6 1.6v.9M1.6 6h.9M2.8 3.2l.6.6M8.4 3.2l-.6.6"/><path d="M6.5 13.6h5.4a2.4 2.4 0 0 0 0-4.8 3.4 3.4 0 0 0-6.4.9 2 2 0 0 0 1 3.9Z" fill="currentColor"/>',
  calendar: '<rect x="2" y="3" width="12" height="11" rx="2.6"/><path d="M2.4 6.6h11.2M5.2 1.6v2.6M10.8 1.6v2.6"/>',
  battery: '<rect x="1.5" y="4.5" width="11.5" height="7" rx="2"/><path d="M14.6 7v2"/><rect x="3" y="6" width="7" height="4" rx="0.8" fill="currentColor" stroke="none"/>',
  tray: '<path d="M2.5 9 4.2 3.6A1.5 1.5 0 0 1 5.6 2.6h4.8a1.5 1.5 0 0 1 1.4 1L13.5 9v3.4a1.5 1.5 0 0 1-1.5 1.5H4a1.5 1.5 0 0 1-1.5-1.5Z"/><path d="M2.5 9h3l1 1.7h3l1-1.7h3M8 4.4v3.4m0 0L6.6 6.4M8 7.8l1.4-1.4"/>',
  airdrop: '<circle cx="8" cy="8.6" r="1.3" fill="currentColor"/><path d="M5.2 11.4a4 4 0 1 1 5.6 0M3.3 13.3a6.7 6.7 0 1 1 9.4 0"/>',
  open: '<rect x="2" y="2.5" width="11.5" height="11.5" rx="2.6"/><path d="M6.4 9.6 11 5m0 0H7.6M11 5v3.4"/>',
  eye: '<path d="M1.6 8S4 3.6 8 3.6 14.4 8 14.4 8 12 12.4 8 12.4 1.6 8 1.6 8Z"/><circle cx="8" cy="8" r="2"/>',
};
const tint = "#d47c6c"; // what Music takes from the cover below
---

<div class="hn" data-hero-notch data-scene="music" data-state="idle" role="img"
     aria-label="The notch showing Music, then a Focus Timer beside it, then Home with every activity, then a file dropped on it">
  <div class="shell">
    <!-- Compact: the live activity either side of the camera -->
    <div class="wings" aria-hidden="true">
      <div class="wing left">
        <span class="for music"><span class="art art-s"></span></span>
        <span class="for live"><span class="ring-s" style="--p: 0.04"></span></span>
      </div>
      <div class="cam"></div>
      <div class="wing right">
        <span class="for music"><span class="wave"><i></i><i></i><i></i><i></i></span></span>
        <span class="for live"><span class="cap" data-clock>24:12</span><span class="circle"><span class="art"></span></span></span>
      </div>
    </div>
    <div class="peek" aria-hidden="true">Lumen Coast • Midnight Drive</div>

    <!-- Open -->
    <div class="expanded" aria-hidden="true">
      <div class="controls">
        <svg class="home-btn" viewBox="0 0 16 16" set:html={sym.grid} />
        <svg viewBox="0 0 16 16" set:html={sym.gear} />
      </div>

      <!-- Music: the headerless player -->
      <section class="page music">
        <div class="player-top">
          <span class="art art-l"></span>
          <div class="meta"><b>Midnight Drive</b><span>Lumen Coast</span></div>
          <span class="wave wave-l"><i></i><i></i><i></i><i></i></span>
        </div>
        <div class="scrub"><span data-pos>01:24</span><i><b data-bar></b></i><span>03:52</span></div>
        <div class="transport">
          <svg class="t-sm" viewBox="0 0 20 20"><path d="M2.5 6h3.2c2 0 3 .8 4.3 3l1 1.7c1.3 2.3 2.3 3.3 4.3 3.3h2.2M14.8 11.8 17.5 14l-2.7 2.2M2.5 14h3.2c1.3 0 2.1-.4 2.9-1.3M17.5 6h-2.2c-1.3 0-2.1.4-2.9 1.3M14.8 3.8 17.5 6l-2.7 2.2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <svg class="t-md" viewBox="0 0 24 24"><path d="M11.6 6.4v11.2L3.4 12l8.2-5.6Zm9.4 0v11.2L12.8 12 21 6.4Z" fill="currentColor"/></svg>
          <svg class="t-lg" viewBox="0 0 24 24"><rect x="5.5" y="4.5" width="4.4" height="15" rx="1.3" fill="currentColor"/><rect x="14.1" y="4.5" width="4.4" height="15" rx="1.3" fill="currentColor"/></svg>
          <svg class="t-md" viewBox="0 0 24 24"><path d="M12.4 6.4v11.2l8.2-5.6-8.2-5.6Zm-9.4 0v11.2l8.2-5.6L3 6.4Z" fill="currentColor"/></svg>
          <svg class="t-sm" viewBox="0 0 20 20"><path d="M3 9.2V8a3 3 0 0 1 3-3h10.5M14 2.5 16.5 5 14 7.5M17 10.8V12a3 3 0 0 1-3 3H3.5M6 17.5 3.5 15 6 12.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </section>

      <!-- Focus Timer -->
      <section class="page timer">
        <div class="t-row">
          <span class="ring-l" data-ring style="--p: 0.04"><svg viewBox="0 0 16 16" set:html={sym.timer} /></span>
          <div class="t-col">
            <span class="caption">FOCUS</span>
            <span class="value"><b data-clock>24:12</b><small>left</small></span>
          </div>
        </div>
        <div class="actions">
          <span class="btn danger" aria-label="Stop"><i></i></span>
          <span class="btn accent"><svg viewBox="0 0 16 16"><rect x="3.6" y="2.6" width="3" height="10.8" rx="1" fill="currentColor"/><rect x="9.4" y="2.6" width="3" height="10.8" rx="1" fill="currentColor"/></svg>Pause</span>
        </div>
      </section>

      <!-- Home: every activity, never scrolling -->
      <section class="page home">
        <div class="tiles">
          <div class="tile wide">
            <span class="art art-m"></span>
            <span class="tcol"><b>Midnight Drive</b><small>Lumen Coast</small></span>
          </div>
          <div class="tile wide">
            <span class="ring-m" style="--p: 0.04"><svg viewBox="0 0 16 16" set:html={sym.timer} /></span>
            <span class="tcol"><small>FOCUS</small><b class="orange"><span data-clock>24:12</span> <em>left</em></b></span>
          </div>
          <div class="tile"><span class="trow"><svg class="cyan" viewBox="0 0 16 16" set:html={sym.cloud} /><b>14°</b></span><small>Weather</small></div>
          <div class="tile"><span class="trow"><svg class="red" viewBox="0 0 16 16" set:html={sym.calendar} /><b>12m</b></span><small>Design review</small></div>
          <div class="tile"><span class="trow"><span class="ring-xs" style="--p: 0.23"></span><b>23%</b></span><small>CPU</small></div>
          <div class="tile"><span class="trow"><svg class="green" viewBox="0 0 16 16" set:html={sym.battery} /><b>82%</b></span><small>Battery</small></div>
        </div>
      </section>

      <!-- A file dragged over the notch: the zones that take it -->
      <section class="page drop">
        <div class="zones">
          <div class="zone shelf"><svg viewBox="0 0 16 16" set:html={sym.tray} /><span><b>Shelf</b><b>Shelf · 1 file</b></span></div>
          <div class="zone"><svg viewBox="0 0 16 16" set:html={sym.airdrop} /><span><b>AirDrop</b></span></div>
          <div class="zone"><svg viewBox="0 0 16 16" set:html={sym.open} /><span><b>Open With</b></span></div>
          <div class="zone"><svg viewBox="0 0 16 16" set:html={sym.eye} /><span><b>Quick Look</b></span></div>
        </div>
      </section>
    </div>
  </div>

  <!-- The file being dragged -->
  <div class="file" aria-hidden="true"><span class="doc"><i>PDF</i></span><span class="name">Brief.pdf</span></div>
</div>

<script>
  type Step = [Record<string, string>, number];
  // How long each presentation stays, in the order the app moves through them.
  const scenes: Record<string, Step[]> = {
    music: [[{ state: "compact" }, 900], [{ state: "peek" }, 1800], [{ state: "expanded" }, 4400], [{ state: "compact" }, 600]],
    timer: [[{ state: "compact", extra: "in" }, 1700], [{ state: "expanded" }, 4200], [{ state: "compact" }, 600]],
    home: [[{ state: "compact" }, 500], [{ state: "expanded" }, 4800], [{ state: "compact" }, 600]],
    drop: [
      [{ state: "compact", drag: "start" }, 250], [{ drag: "rise" }, 900], [{ state: "expanded" }, 650],
      [{ drag: "over" }, 1900], [{ drag: "done" }, 500], [{ state: "compact" }, 1100], [{ drag: "" }, 100],
    ],
  };
  const order = Object.keys(scenes);
  const total = (scene: string) => scenes[scene].reduce((sum, [, ms]) => sum + ms, 0);
  const clock = (s: number, pad = false) => `${String(Math.floor(s / 60)).padStart(pad ? 2 : 1, "0")}:${String(s % 60).padStart(2, "0")}`;

  document.addEventListener("astro:page-load", () => {
    const notch = document.querySelector<HTMLElement>("[data-hero-notch]");
    if (!notch) return;
    const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-notch-tab]")];
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let index = 0, timers: number[] = [], hovering = false, visible = true;
    let seconds = 24 * 60 + 12, position = 84;

    const clear = () => { timers.forEach(clearTimeout); timers = []; };
    const apply = (step: Record<string, string>) => {
      for (const [key, value] of Object.entries(step)) {
        if (key === "state" && hovering) continue;
        if (value) notch!.dataset[key] = value; else delete notch!.dataset[key];
      }
    };
    function select(i: number) {
      index = i;
      notch!.dataset.scene = order[i];
      delete notch!.dataset.drag;
      // Music plays throughout, so it joins the wings once the timer starts.
      if (order[i] === "music") delete notch!.dataset.extra; else notch!.dataset.extra ??= "in";
      tabs.forEach((tab) => {
        const on = tab.dataset.notchTab === order[i];
        tab.setAttribute("aria-selected", String(on));
        tab.style.setProperty("--run", "0s");
        tab.classList.remove("running");
        if (on && !reduced && !hovering) { void tab.offsetWidth; tab.style.setProperty("--run", `${total(order[i])}ms`); tab.classList.add("running"); }
      });
    }
    function play(i: number) {
      clear();
      select(i);
      if (reduced) { notch!.dataset.state = "expanded"; return; }
      let at = 0;
      for (const [step, ms] of scenes[order[i]]) {
        timers.push(window.setTimeout(() => apply(step), at));
        at += ms;
      }
      timers.push(window.setTimeout(() => { if (visible && !hovering) play((i + 1) % order.length); }, at));
    }

    tabs.forEach((tab) => tab.addEventListener("click", () => {
      const i = order.indexOf(tab.dataset.notchTab!);
      if (order[i] === "drop") { play(i); return; }
      clear(); select(i);
      notch.dataset.state = "expanded";
      timers.push(window.setTimeout(() => !hovering && play((index + 1) % order.length), 5200));
    }));
    notch.addEventListener("pointerenter", () => {
      hovering = true; clear();
      tabs.forEach((tab) => tab.classList.remove("running"));
      delete notch.dataset.drag;
      notch.dataset.state = "expanded";
    });
    notch.addEventListener("pointerleave", () => {
      hovering = false;
      notch.dataset.state = "compact";
      timers.push(window.setTimeout(() => play((index + 1) % order.length), 900));
    });

    const tick = window.setInterval(() => {
      if (!visible) return;
      seconds = seconds > 0 ? seconds - 1 : 25 * 60;
      position = (position + 1) % 232;
      const progress = 1 - seconds / 1500;
      notch.querySelectorAll("[data-clock]").forEach((el) => { el.textContent = clock(seconds); });
      notch.querySelector("[data-pos]")!.textContent = clock(position, true);
      notch.querySelector<HTMLElement>("[data-bar]")!.style.width = `${(position / 232) * 100}%`;
      notch.querySelectorAll<HTMLElement>("[style*='--p']").forEach((el) => {
        if (!el.closest(".tile:not(.wide)")) el.style.setProperty("--p", progress.toFixed(4));
      });
    }, 1000);

    const observer = new IntersectionObserver(([entry]) => {
      const was = visible; visible = entry.isIntersecting;
      if (visible && !was) play(index); else if (!visible) clear();
    });
    observer.observe(notch);

    // The notch drops in from the camera, as when the app launches.
    timers.push(window.setTimeout(() => play(0), reduced ? 0 : 500));
    document.addEventListener("astro:before-swap", () => { clear(); clearInterval(tick); observer.disconnect(); }, { once: true });
  });
</script>

<style define:vars={{ tint }}>
  /* Presentation sizes from NotchGeometry and HomeLayout, camera 184 × 32 */
  .hn {
    --w: 184px; --h: 32px; --shoulder: 0px; --r: 12px; --shadow: 0;
    --orange: rgb(255 158 77); --orange-from: rgb(255 102 92); --cyan: rgb(97 204 250);
    --green: rgb(115 219 140); --red: rgb(255 115 110); --ink-2: rgb(255 255 255 / 0.58);
    position: absolute; top: 0; left: 50%; z-index: 40;
    width: var(--w); height: var(--h);
    transform: translateX(-50%);
    zoom: var(--zoom, 1.3);
    transition: width 0.36s var(--spring-close), height 0.36s var(--spring-close), --shoulder 0.36s var(--spring-close);
    filter: drop-shadow(0 7px calc(var(--shadow) * 16px) rgb(0 0 0 / calc(var(--shadow) * 0.5)));
    font-family: var(--font);
    color: #fff;
    -webkit-font-smoothing: antialiased;
  }
  .hn[data-state="compact"] { --w: 328px; --shoulder: 5px; }
  .hn[data-state="compact"][data-scene="music"] { --w: 252px; }
  .hn[data-state="peek"] { --w: 320px; --h: 78px; --shoulder: 18px; --r: 22px; --shadow: 0.55; }
  .hn[data-state="expanded"] {
    --w: 384px; --shoulder: 28px; --r: 34px; --shadow: 1;
    transition: width 0.44s var(--spring-open), height 0.44s var(--spring-open), --shoulder 0.44s var(--spring-open);
  }
  .hn[data-state="expanded"][data-scene="music"] { --h: 188px; }
  .hn[data-state="expanded"][data-scene="timer"] { --h: 150px; }
  .hn[data-state="expanded"][data-scene="home"] { --w: 456px; --h: 206px; }
  .hn[data-state="expanded"][data-scene="drop"] { --w: 456px; --h: 134px; }

  /* The shoulders: concave corners that join the screen edge */
  .hn::before, .hn::after {
    content: ""; position: absolute; top: 0; width: var(--shoulder); height: var(--shoulder);
  }
  .hn::before { right: 100%; background: radial-gradient(circle at 0 100%, transparent calc(var(--shoulder) - 0.5px), #000 var(--shoulder)); }
  .hn::after { left: 100%; background: radial-gradient(circle at 100% 100%, transparent calc(var(--shoulder) - 0.5px), #000 var(--shoulder)); }

  .shell {
    position: absolute; inset: 0; overflow: hidden; background: #000;
    border-radius: 0 0 var(--r) var(--r);
    transition: border-radius 0.4s var(--spring-open);
  }

  /* Which scene's content is showing */
  .for { display: none; }
  [data-scene="music"] .for.music, .hn:not([data-scene="music"]) .for.live { display: contents; }
  .page { display: none; }
  [data-scene="music"] .page.music, [data-scene="timer"] .page.timer,
  [data-scene="home"] .page.home, [data-scene="drop"] .page.drop { display: flex; }

  /* Compact wings: leading hugs the outer left edge, trailing the outer right */
  .wings {
    position: absolute; inset: 0 0 auto; height: 32px; display: flex; align-items: center;
    transition: opacity 0.13s ease-out, filter 0.13s ease-out;
  }
  .wing { flex: 1; display: flex; align-items: center; gap: 3px; min-width: 0; color: rgb(255 255 255 / 0.92); }
  .wing.left { justify-content: flex-start; padding: 0 6px 0 10px; }
  .wing.right { justify-content: flex-end; padding: 0 10px 0 6px; }
  .cam { width: 184px; flex: none; }
  .hn[data-state="idle"] .wings { opacity: 0; }
  .hn[data-state="expanded"] .wings { opacity: 0; filter: blur(3px); }
  .cap { font-size: 11px; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--orange); }

  /* Another live activity, as a circle after the reading */
  .circle {
    width: 18px; height: 18px; margin-left: 5px; border-radius: 50%; background: rgb(255 255 255 / 0.08);
    display: grid; place-items: center; overflow: hidden; flex: none;
    transform: scale(0.2); opacity: 0; transition: transform 0.4s var(--spring-open), opacity 0.2s;
  }
  .circle .art { width: 11px; height: 11px; border-radius: 2.4px; }
  .hn[data-extra="in"] .circle { transform: none; opacity: 1; transition-delay: 0.5s; }

  /* Artwork: a sunset cover */
  .art { display: block; flex: none; background:
    radial-gradient(circle at 50% 62%, #ffd27a 0 17%, transparent 18%),
    linear-gradient(180deg, #6b2966 0%, #ed5c61 36%, #ff9e52 57%, #9e404c 58%, #4d1f3d 100%); }
  .art-s { width: 18px; height: 18px; border-radius: 4px; }
  .art-m { width: 40px; height: 40px; border-radius: 8.8px; }
  .art-l { width: 60px; height: 60px; border-radius: 13.2px; box-shadow: inset 0 0 0 0.5px rgb(255 255 255 / 0.08); }
  .wave { display: flex; align-items: center; gap: 2px; width: 16px; height: 16px; justify-content: center; }
  .wave i { width: 2px; height: 9px; border-radius: 2px; background: var(--tint); animation: wave 0.9s ease-in-out infinite alternate; }
  .wave i:nth-child(2) { animation-duration: 0.72s; animation-delay: -0.3s; }
  .wave i:nth-child(3) { animation-duration: 0.83s; animation-delay: -0.5s; }
  .wave i:nth-child(4) { animation-duration: 0.66s; animation-delay: -0.15s; }
  @keyframes wave { from { height: 4px; } to { height: 13px; } }

  /* Rings: progress from the accent's neighboring hue to the accent */
  .ring-s, .ring-m, .ring-l, .ring-xs {
    --p: 0; --track: rgb(255 255 255 / 0.14);
    position: relative; flex: none; border-radius: 50%; display: grid; place-items: center; color: var(--orange);
    background:
      radial-gradient(closest-side, #000 calc(100% - var(--stroke)), transparent calc(100% - var(--stroke) + 0.5px)),
      conic-gradient(var(--orange-from), var(--orange) calc(var(--p) * 100%), var(--track) 0);
  }
  .ring-s { width: 15px; height: 15px; --stroke: 2.4px; }
  .ring-xs { width: 16px; height: 16px; --stroke: 2.4px; --orange-from: rgb(97 160 250); --orange: var(--cyan); }
  .ring-m { width: 40px; height: 40px; --stroke: 5px; }
  .ring-l { width: 50px; height: 50px; --stroke: 6.5px; }
  .ring-m svg { width: 14px; height: 14px; }
  .ring-l svg { width: 17px; height: 17px; }
  svg { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; }

  /* Peek: one line under the camera */
  .peek {
    position: absolute; top: 32px; inset-inline: 0; height: 46px; padding: 0 24px;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; font-weight: 600; color: rgb(255 255 255 / 0.65); white-space: nowrap; overflow: hidden;
    opacity: 0; filter: blur(4px); transform: translateY(-22px);
    transition: opacity 0.18s ease-out, filter 0.18s ease-out, transform 0.18s ease-out;
  }
  .hn[data-state="peek"] .peek { opacity: 1; filter: none; transform: none; transition-delay: 0.06s; }

  /* Open */
  .expanded {
    position: absolute; top: 0; left: 0; width: var(--w);
    opacity: 0; filter: blur(5px); transform: translateY(-6px) scale(0.96); transform-origin: top center;
    transition: opacity 0.18s ease-out, filter 0.18s ease-out, transform 0.18s ease-out;
    pointer-events: none;
  }
  .hn[data-state="expanded"] .expanded { opacity: 1; filter: none; transform: none; transition-delay: 0.07s; }
  /* Home and Settings, top right over every page */
  .controls { position: absolute; top: 0; right: 24px; height: 40px; display: flex; align-items: center; gap: 2px; color: rgb(255 255 255 / 0.5); z-index: 1; }
  .controls svg { width: 24px; height: 24px; padding: 6px; stroke-width: 1.3; }
  [data-scene="home"] .home-btn { display: none; }
  .page { flex-direction: column; }

  .page.music { padding: 14px 27px 0; }
  .player-top { display: flex; align-items: flex-start; gap: 9px; }
  .meta { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; padding-top: 24px; white-space: nowrap; }
  .meta b { font-size: 14px; font-weight: 700; color: rgb(255 255 255 / 0.9); line-height: 1.2; }
  .meta span { font-size: 13px; font-weight: 600; color: rgb(255 255 255 / 0.45); line-height: 1.2; }
  .wave-l { height: 60px; margin-right: 25px; }
  .scrub { display: flex; align-items: center; gap: 10px; margin-top: 22px; height: 16px; font-size: 10px; font-weight: 500; color: rgb(255 255 255 / 0.45); font-variant-numeric: tabular-nums; }
  .scrub span { width: 30px; } .scrub span:last-child { text-align: right; }
  .scrub i { flex: 1; height: 4px; border-radius: 4px; background: rgb(255 255 255 / 0.14); overflow: hidden; }
  .scrub b { display: block; height: 100%; width: 36%; border-radius: inherit; background: var(--tint); transition: width 1s linear; }
  .transport { display: flex; justify-content: center; align-items: center; gap: 14px; margin-top: 15px; height: 40px; }
  .transport svg { width: 40px; height: 40px; padding: 11px; stroke: none; }
  .t-sm { color: rgb(255 255 255 / 0.45); padding: 11.5px !important; }
  .t-md { padding: 7.5px !important; }
  .t-lg { width: 44px !important; padding: 7px !important; }

  /* Focus Timer, as the extension's Row, Ring, Value and Actions draw */
  .page.timer { padding: 42px 28px 0; }
  .t-row { display: flex; align-items: center; gap: 14px; }
