---
// The site's top bar works like the Mac's menu bar: items left and right,
// and a gap in the middle where the camera, and the notch, would be. It's
// persisted across navigation, so only its current item moves.
import Icon from "./Icon.astro";
import { release, repository } from "../lib/site";

const links = [
  { href: "/store/", label: "Store", match: "/store/" },
  { href: "/docs/", label: "Docs", match: "/docs/" },
  { href: "/docs/extensions/getting-started/", label: "Developers", match: "/docs/extensions/" },
  { href: "/changelog/", label: "Changelog", match: "/changelog/" },
];
---

<header class="nav" data-nav transition:persist="nav">
  <div class="bar">
    <div class="side left">
      <a href="/" class="brand" aria-label="NotchNotch home"><Icon name="logo" size={16} /><span>NotchNotch</span></a>
      <nav class="links" aria-label="Main" data-blob="a">
        {links.map((link) => <a href={link.href} data-match={link.match}>{link.label}</a>)}
      </nav>
    </div>

    <div class="camera" aria-hidden="true"></div>

    <div class="side right">
      <button class="search" type="button" data-open-search aria-label="Search">
        <Icon name="search" size={14} /><span class="search-label">Search</span><kbd>⌘K</kbd>
      </button>
      <a class="icon-link" href={repository} aria-label="NotchNotch on GitHub"><Icon name="github" size={16} /></a>
      <a class="button primary get" href={release.url}>Download</a>
      <button class="icon-link menu" type="button" data-menu aria-label="Menu" aria-expanded="false"><Icon name="menu" size={18} /></button>
    </div>
  </div>

  <div class="sheet" data-sheet>
    {links.map((link) => <a href={link.href} data-match={link.match}>{link.label}</a>)}
    <a href={repository}>GitHub</a>
    <a class="button primary large" href={release.url}><Icon name="download" /> Download {release.version}</a>
  </div>
</header>

<script>
  import { blobs } from "../lib/blob";

  // The nav survives navigation, so bind once and only update the current item.
  const nav = document.querySelector<HTMLElement>("[data-nav]")!;
  const menu = nav.querySelector<HTMLButtonElement>("[data-menu]")!;
  const setOpen = (open: boolean) => {
    nav.classList.toggle("open", open);
    menu.setAttribute("aria-expanded", String(open));
    document.documentElement.classList.toggle("locked", open);
  };
  menu.addEventListener("click", () => setOpen(!nav.classList.contains("open")));
  addEventListener("scroll", () => nav.classList.toggle("scrolled", scrollY > 4), { passive: true });

  function mark() {
    const path = location.pathname;
    for (const group of nav.querySelectorAll(".links, .sheet")) {
      const anchors = [...group.querySelectorAll<HTMLAnchorElement>("a[data-match]")];
      // The most specific match wins: "Developers" over "Docs" inside /docs/extensions/.
      const best = anchors.filter((a) => path.startsWith(a.dataset.match!)).sort((a, b) => b.dataset.match!.length - a.dataset.match!.length)[0];
      anchors.forEach((a) => a === best ? a.setAttribute("aria-current", "page") : a.removeAttribute("aria-current"));
    }
    nav.classList.toggle("scrolled", scrollY > 4);
    nav.classList.toggle("over-notch", !!document.querySelector("[data-hero-notch]"));
    setOpen(false);
    blobs(nav);
  }
  document.addEventListener("astro:page-load", mark);
</script>

<style>
  /* The bar's middle lets the pointer through to the notch drawn under it. */
  .nav { position: fixed; inset: 0 0 auto; z-index: 50; pointer-events: none; }
  .side, .sheet { pointer-events: auto; }
  .nav::before {
    content: ""; position: absolute; inset: 0; height: var(--nav-h); z-index: -1;
    background: rgb(18 18 18 / 0.78);
    backdrop-filter: saturate(160%) blur(18px); -webkit-backdrop-filter: saturate(160%) blur(18px);
    box-shadow: 0 1px 0 var(--line);
    opacity: 0; transition: opacity var(--fast);
  }
  .nav.scrolled::before, .nav.open::before { opacity: 1; }

  .bar { height: var(--nav-h); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 14px 0 20px; }
  .side { display: flex; align-items: center; gap: 6px; min-width: 0; }
  .right { justify-content: flex-end; }
  .camera { width: 330px; }

  .brand { display: inline-flex; align-items: center; gap: 9px; font-weight: 600; font-size: 14px; margin-right: 14px; }
  .links { display: flex; }
  .links a { padding: 0 12px; height: 32px; display: grid; place-items: center; border-radius: 999px; font-size: 13.5px; color: var(--text-2); transition: color var(--quick); }
  .links a:hover, .links a[aria-current="page"] { color: var(--text); }
  .links :global(.blob) { --blob: rgb(255 255 255 / 0.07); }

  .search {
    display: inline-flex; align-items: center; gap: 8px; height: 32px; padding: 0 6px 0 11px;
    border: 0; border-radius: 999px; cursor: pointer; background: var(--chip); color: var(--text-3); font-size: 13px;
    transition: background-color var(--quick), color var(--quick);
  }
  .search:hover { background: var(--chip-hover); color: var(--text-2); }
  .search-label { margin-right: 22px; }
  .icon-link { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 999px; border: 0; background: none; cursor: pointer; color: var(--text-2); transition: color var(--quick), background-color var(--quick); }
  .icon-link:hover { color: var(--text); background: var(--chip); }
  .get { --h: 32px; padding: 0 14px; font-size: 13px; margin-left: 2px; }
  .menu, .sheet { display: none; }

  @media (max-width: 1199px) {
    .bar { grid-template-columns: 1fr auto; }
    .camera { display: none; }
  }
  @media (max-width: 820px) {
    .links, .get, .search-label, .search kbd { display: none; }
    .search { width: 32px; padding: 0; justify-content: center; }
    .menu { display: grid; }
    .sheet {
      display: flex; flex-direction: column; gap: 2px; position: fixed; inset: var(--nav-h) 0 0; padding: 16px 20px;
      background: var(--bg); opacity: 0; transform: translateY(-6px); pointer-events: none;
      transition: opacity var(--fast) var(--ease), transform var(--fast) var(--ease);
    }
    .sheet a:not(.button) { font-size: 24px; font-weight: 600; letter-spacing: -0.025em; padding: 8px 0; color: var(--text-3); }
    .sheet a[aria-current="page"] { color: var(--text); }
    .sheet .button { margin-top: 20px; }
    .open .sheet { opacity: 1; transform: none; pointer-events: auto; }
  }
  :global(html.locked) { overflow: hidden; }
</style>
