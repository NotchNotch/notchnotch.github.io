---
import type { MarkdownHeading } from "astro";
import { getCollection } from "astro:content";
import Base from "./Base.astro";
import Icon from "../components/Icon.astro";
import { docsNav, url } from "../lib/site";
import "../styles/prose.css";

interface Props { id: string; title: string; description?: string; headings: MarkdownHeading[]; editUrl?: string; tocDepth?: number }
const { id, title, description, headings, editUrl, tocDepth = 3 } = Astro.props;

const titles = new Map((await getCollection("docs")).map((entry) => [entry.id, entry.data.title]));
const nav = docsNav.map((group) => ({
  label: group.label,
  items: group.items.filter((item) => titles.has(item.id)).map((item) => ({ ...item, label: item.label ?? titles.get(item.id)! })),
}));
// Decision records sit together; any of them counts as the "Decisions" item.
const activeId = id.startsWith("docs/internals/decisions/") ? "docs/internals/decisions/0001-native-extension-platform" : id;
const flat = nav.flatMap((group) => group.items.map((item) => ({ ...item, group: group.label })));
const index = flat.findIndex((item) => item.id === activeId);
const current = flat[index];
const previous = index > 0 ? flat[index - 1] : undefined;
const next = index >= 0 && index < flat.length - 1 ? flat[index + 1] : undefined;
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= tocDepth);
---

<Base title={title} description={description} animate={false}>
  <div class="docs">
    <!-- Persisted: it stays still while pages change, and its highlight slides to the new page. -->
    <aside class="sidebar" data-sidebar transition:persist="docs-sidebar">
      <button class="side-toggle" type="button" data-side-toggle aria-expanded="false">
        <Icon name="book" size={15} /><span data-side-current>{current?.label ?? title}</span><Icon name="chevron" size={13} class="chev" />
      </button>
      <nav class="side-nav" aria-label="Documentation" data-blob="a">
        <button class="side-search" type="button" data-open-search><Icon name="search" size={13} /> Search <kbd>⌘K</kbd></button>
        {nav.map((group) => (
          <div class="group">
            <h2>{group.label}</h2>
            {group.items.map((item) => <a href={url(item.id)} data-id={item.id}>{item.label}</a>)}
          </div>
        ))}
        <div class="group">
          <h2>Store</h2>
          <a href="/store/">Browse extensions</a>
        </div>
      </nav>
    </aside>

    <article class="article" transition:name="doc" data-active-id={activeId}>
      <header class="page-head">
        {current && <span class="crumb">{current.group}</span>}
        <h1>{title}</h1>
        {description && <p class="lede">{description}</p>}
      </header>
      <div class="prose" data-prose>
        <slot />
      </div>

      <footer class="page-foot">
        <nav class="pager" aria-label="Pages">
          {previous ? <a class="stage-card prev" href={url(previous.id)}><span>Previous</span><b>{previous.label}</b></a> : <span />}
          {next && <a class="stage-card next" href={url(next.id)}><span>Next</span><b>{next.label}</b></a>}
        </nav>
        {editUrl && <a class="edit" href={editUrl}><Icon name="edit" size={14} /> Edit this page on GitHub</a>}
      </footer>
    </article>

    <aside class="toc" aria-label="On this page" transition:name="toc">
      {toc.length > 0 && (
        <div class="toc-inner">
          <h2>On this page</h2>
          <ul data-blob="a" data-blob-follow="false">
            {toc.map((heading) => <li class={`d${heading.depth}`}><a href={`#${heading.slug}`} data-toc={heading.slug}>{heading.text}</a></li>)}
          </ul>
        </div>
      )}
    </aside>
  </div>
</Base>

<script>
  function setup() {
    const prose = document.querySelector<HTMLElement>("[data-prose]");
    if (!prose) return;
    const activeId = document.querySelector<HTMLElement>("[data-active-id]")!.dataset.activeId!;

    // The sidebar persists, so mark the current page on it here.
    const sidebar = document.querySelector<HTMLElement>("[data-sidebar]")!;
    let currentLabel = "";
    sidebar.querySelectorAll<HTMLAnchorElement>("[data-id]").forEach((a) => {
      const on = a.dataset.id === activeId;
      on ? a.setAttribute("aria-current", "page") : a.removeAttribute("aria-current");
      if (on) currentLabel = a.textContent ?? "";
    });
    sidebar.querySelector("[data-side-current]")!.textContent = currentLabel || document.title.split(" · ")[0];
    sidebar.classList.remove("open");
    if (!sidebar.dataset.bound) {
      sidebar.dataset.bound = "true";
      const toggle = sidebar.querySelector<HTMLButtonElement>("[data-side-toggle]")!;
      toggle.addEventListener("click", () => toggle.setAttribute("aria-expanded", String(sidebar.classList.toggle("open"))));
    }
    const nav = sidebar.querySelector<HTMLElement>(".side-nav")!;
    const link = sidebar.querySelector<HTMLElement>("[aria-current]");
    if (link && (link.offsetTop < nav.scrollTop || link.offsetTop > nav.scrollTop + nav.clientHeight - 40)) {
      nav.scrollTo({ top: link.offsetTop - nav.clientHeight / 3, behavior: "smooth" });
    }

    for (const heading of prose.querySelectorAll<HTMLElement>("h2[id], h3[id], h4[id]")) {
      const a = document.createElement("a");
      a.href = `#${heading.id}`; a.className = "anchor"; a.setAttribute("aria-label", "Link to this section"); a.textContent = "#";
      heading.append(a);
    }
    for (const pre of prose.querySelectorAll<HTMLElement>("pre")) {
      const wrap = document.createElement("div"); wrap.className = "code-block";
      pre.replaceWith(wrap); wrap.append(pre);
      const lang = pre.dataset.language;
      if (lang && lang !== "plaintext") { const tag = document.createElement("span"); tag.className = "lang"; tag.textContent = lang; wrap.append(tag); }
      const button = document.createElement("button");
      button.type = "button"; button.className = "copy"; button.textContent = "Copy";
      button.addEventListener("click", async () => {
        await navigator.clipboard?.writeText(pre.innerText);
        button.textContent = "Copied"; button.classList.add("done");
        setTimeout(() => { button.textContent = "Copy"; button.classList.remove("done"); }, 1500);
      });
      wrap.append(button);
    }
    for (const table of prose.querySelectorAll("table")) {
      const wrap = document.createElement("div"); wrap.className = "table-wrap";
      table.replaceWith(wrap); wrap.append(table);
    }

    // The section being read: the last heading above the top third of the window.
    const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")];
    const headings = links.map((a) => document.getElementById(a.dataset.toc!)).filter(Boolean) as HTMLElement[];
    const update = () => {
      const line = innerHeight * 0.3;
      let active = headings[0];
      for (const heading of headings) if (heading.getBoundingClientRect().top <= line) active = heading;
      if (innerHeight + scrollY >= document.body.scrollHeight - 4) active = headings[headings.length - 1];
      links.forEach((a) => a.classList.toggle("active", a.dataset.toc === active?.id));
    };
    if (headings.length) {
      update();
      addEventListener("scroll", update, { passive: true });
      document.addEventListener("astro:before-swap", () => removeEventListener("scroll", update), { once: true });
    }
  }
  document.addEventListener("astro:page-load", setup);
</script>

<style>
  .docs {
    --side: 236px; --toc: 208px;
    width: 100%; max-width: 1400px; margin: 0 auto; padding: calc(var(--nav-h) + 36px) 24px 0;
    display: grid; grid-template-columns: var(--side) minmax(0, 1fr) var(--toc); gap: 56px;
  }

  .sidebar { position: sticky; top: calc(var(--nav-h) + 24px); align-self: start; }
  .side-toggle { display: none; }
  .side-nav { max-height: calc(100vh - var(--nav-h) - 48px); overflow-y: auto; padding: 0 4px 32px 0; scrollbar-width: none; }
  .side-nav :global(.blob) { --blob: rgb(255 255 255 / 0.06); --br: 8px; }
  .side-search {
    width: 100%; display: flex; align-items: center; gap: 8px; height: 32px; padding: 0 6px 0 10px; margin-bottom: 22px;
    border: 0; border-radius: 9px; cursor: pointer; font-size: 13px; color: var(--text-3); background: var(--chip);
    transition: color var(--quick), background-color var(--quick);
  }
  .side-search:hover { color: var(--text-2); background: var(--chip-hover); }
  .side-search kbd { margin-left: auto; background: rgb(255 255 255 / 0.06); }
  .group + .group { margin-top: 22px; }
  .group h2 { font-size: 12px; font-weight: 500; color: var(--text-3); margin: 0 0 4px 10px; }
  .group a {
    display: block; padding: 5px 10px; border-radius: 8px; font-size: 13.5px; color: var(--text-2); line-height: 1.4;
    transition: color var(--quick);
  }
  .group a:hover { color: var(--text); }
  .group a[aria-current="page"] { color: var(--text); font-weight: 500; }

  .article { min-width: 0; max-width: 740px; padding-bottom: 24px; }
  .crumb { font-size: 13px; color: var(--text-3); font-weight: 500; }
  .page-head h1 { font-family: var(--font-display); font-size: clamp(30px, 3.6vw, 40px); font-weight: 600; letter-spacing: -0.03em; line-height: 1.12; margin: 6px 0 0; text-wrap: balance; }
  .page-head .lede { margin-top: 12px; }

  .page-foot { margin-top: 64px; display: flex; flex-direction: column; gap: 20px; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .pager a { padding: 14px 16px; gap: 2px; }
  .pager span { font-size: 12px; color: var(--text-3); }
  .pager b { font-weight: 500; font-size: 14px; }
  .pager .next { text-align: right; grid-column: 2; }
  .pager .prev span::before { content: "← "; }
  .pager .next span::after { content: " →"; }
  .edit { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; color: var(--text-3); transition: color var(--quick); }
  .edit:hover { color: var(--text); }

  .toc { position: sticky; top: calc(var(--nav-h) + 24px); align-self: start; max-height: calc(100vh - var(--nav-h) - 48px); overflow-y: auto; scrollbar-width: none; }
  .toc h2 { font-size: 12px; font-weight: 500; margin: 0 0 10px; color: var(--text-3); }
  .toc ul { list-style: none; margin: 0; padding: 0; box-shadow: inset 1px 0 0 var(--line-strong); }
  .toc ul :global(.blob) { width: 1.5px !important; --blob: var(--text); --br: 2px; }
  .toc a { display: block; padding: 4px 0 4px 14px; font-size: 12.5px; color: var(--text-3); line-height: 1.45; transition: color var(--fast) var(--ease); }
  .toc .d3 a { padding-left: 26px; }
  .toc a:hover { color: var(--text-2); }
  .toc a:global(.active) { color: var(--text); }

  @media (max-width: 1180px) {
    .docs { grid-template-columns: var(--side) minmax(0, 1fr); }
    .toc { display: none; }
  }
  @media (max-width: 820px) {
    .docs { grid-template-columns: 1fr; gap: 0; padding: var(--nav-h) 20px 0; }
    .sidebar {
      top: var(--nav-h); z-index: 20; margin: 0 -20px;
      background: rgb(18 18 18 / 0.85); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); box-shadow: 0 1px 0 var(--line);
    }
    .side-toggle { display: flex; align-items: center; gap: 10px; width: 100%; height: 44px; padding: 0 20px; border: 0; background: none; cursor: pointer; font-size: 13.5px; }
    .side-toggle :global(.chev) { margin-left: auto; transition: transform var(--fast) var(--ease); }
    .sidebar.open .side-toggle :global(.chev) { transform: rotate(90deg); }
    .side-nav { display: none; max-height: 70vh; padding: 8px 20px 20px; }
    .sidebar.open .side-nav { display: block; }
    .article { padding-top: 28px; }
  }
</style>
